#!/bin/sh
set -e
# The privileged rootless app has no guaranteed sandbox data container.
# Keep its persistent authentication and export files in a mobile-owned path.
store='/var/mobile/Library/Application Support/com.soum91.appvault'
if [ -L "$store" ]; then
    echo 'AppVault storage directory must not be a symlink' >&2
    exit 1
fi
install -d -m 0700 -o mobile -g mobile "$store"
install -d -m 0700 -o mobile -g mobile "$store/AuthenticationRuntime"
install -d -m 0700 -o mobile -g mobile "$store/Temporary"
install -d -m 0700 -o mobile -g mobile "$store/Exports"
if [ -x /var/jb/usr/bin/uicache ]; then
    # 0.6.5/0.6.6 installed AppVaultDecryptor.app; drop that stale icon.
    /var/jb/usr/bin/uicache -u /var/jb/Applications/AppVaultDecryptor.app 2>/dev/null || true
    /var/jb/usr/bin/uicache -p /var/jb/Applications/AppVault.app
fi
exit 0
